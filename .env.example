LLM_BACKEND=ollama
OLLAMA_FAST_MODEL=qwen2.5:0.5b
OLLAMA_QUALITY_MODEL=qwen3:8b
# For OpenAI instead, set LLM_BACKEND=openai and your own key:
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_QUALITY_MODEL=gpt-4o
POLICY_EMBEDDING_BACKEND=ollama
POLICY_EMBEDDING_MODEL=qwen3-embedding:0.6b
POLICY_CHROMA_DIR=data/chroma
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=policy-agent
